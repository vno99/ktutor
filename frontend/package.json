{
  "name": "ktutor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:e2e",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "next": "16.0.4",
    "next-intl": "4.14.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zustand": "5.0.2",
    "axios": "1.7.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.49.1",
    "@types/node": "20.17.10",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "16.0.4",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2"
  }
}
