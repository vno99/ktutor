{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/fr/",
        "http://localhost:3000/fr/chat",
        "http://localhost:3000/fr/upload",
        "http://localhost:3000/fr/dashboard/eleve",
        "http://localhost:3000/en/dashboard/eleve",
        "http://localhost:3000/fr/dashboard/parent",
        "http://localhost:3000/fr/dashboard/parent/bob",
        "http://localhost:3000/fr/history",
        "http://localhost:3000/en/history",
        "http://localhost:3000/en/chat",
        "http://localhost:3000/en/upload"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          { "minScore": 0.9 }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.9 }
        ],
        "categories:performance": [
          "warn",
          { "minScore": 0.7 }
        ],
        "categories:seo": [
          "warn",
          { "minScore": 0.7 }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouseci"
    }
  }
}
