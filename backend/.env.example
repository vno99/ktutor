# ktutor backend - example environment variables.
# Copy to backend/.env and fill in real values. NEVER commit a real .env.

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://ktutor:ktutor@localhost:5432/ktutor
DATABASE_POOL_SIZE=20

# ---- Vector Store (ChromaDB) ----
# Path used by chromadb.PersistentClient (local mode).
CHROMA_PERSIST_DIRECTORY=./chroma_data
# Server URL used when CHROMA_SERVER is enabled (future).
CHROMA_SERVER_URL=http://localhost:8500

# ---- Vision (OCR) ----
# Provider used for OCR of scanned PDFs and handwritten/typed images.
# Allowed values: deepseek-ocr-2 | openai | gemini
VISION_PROVIDER=deepseek-ocr-2
# Endpoint of the local DeepSeek-OCR-2 service.
DEEPSEEK_OCR_URL=http://localhost:8500
DEEPSEEK_OCR_TIMEOUT=60

# ---- File storage (S3-compatible, SeaweedFS) ----
# S3-compatible object store. The Python SDK is the `minio` package
# (S3-compatible, works against any S3 gateway including SeaweedFS).
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=ktutor
S3_SECRET_KEY=ktutor-secret
S3_BUCKET=assistant-documents

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=20

# ---- LLM (chat / generation) and embeddings fallback ----
# Text LLM provider. Allowed: minimax | openai | mistral | ollama
LLM_PROVIDER=minimax
# Only used if LLM_PROVIDER=openai (or for the OpenAI embeddings fallback).
OPENAI_API_KEY=

# ---- Chat LLM (s02) — used by the maths agent via OpenRouter ----
# API key sent to the OpenAI-compatible endpoint. Required for any provider.
LLM_API_KEY=
# Base URL of the OpenAI-compatible endpoint. Default routes minimax through OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model identifier as the upstream expects it (e.g. minimax/minimax-m3:free on OpenRouter, gpt-4o on openai).
LLM_MODEL=minimax/minimax-m3:free
# Reproducibility — 0 for tests, 0.3 for prod is recommended but the agent runs at 0.
CHAT_TEMPERATURE=0.0
# Top-k chunks passed to the LLM context window.
CHAT_TOP_K=4
# Fallback answer when the collection is empty (no document for this pseudo / subject).
CHAT_NO_DOCUMENT_MESSAGE=Je n'ai pas trouvé d'information sur ce sujet dans tes documents.

# ---- QCM generation (s03) ----
# Number of questions generated when --n is not provided.
QCM_DEFAULT_QUESTIONS=5
# Hard cap on the number of questions per generation.
QCM_MAX_QUESTIONS=20
# Number of retry attempts when the LLM returns malformed JSON.
QCM_MAX_RETRIES=1
# Sampling temperature for QCM generation. 0 for reproducibility.
QCM_TEMPERATURE=0.0

# ---- Free-style exercise generation (s06 — probleme / redaction) ----
# Default difficulty when --difficulty is not provided.
FREE_DEFAULT_DIFFICULTY=moyen
# Comma-separated list of accepted difficulty values (parsed by the CLI).
FREE_DIFFICULTY_OPTIONS=facile,moyen,difficile
# Number of retry attempts when the LLM returns malformed JSON.
FREE_MAX_RETRIES=1
# Sampling temperature for free-style generation. 0 for reproducibility.
FREE_TEMPERATURE=0.0
# Safety net below the String(8192) column ceiling — a statement beyond
# this length triggers ``statement_too_long`` instead of a DB-side truncation.
FREE_MAX_STATEMENT_CHARS=8000
